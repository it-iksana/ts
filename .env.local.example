# Copy this to .env.local for local development, and set the same values
# in Vercel's Project Settings → Environment Variables for deployment.
# All three come from the Supabase dashboard: Settings → API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://qcdxzxjocckvjlztchpi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER-ONLY — deliberately no NEXT_PUBLIC_ prefix, which is what keeps
# this out of the browser bundle. Used only for admin operations that
# need to bypass Row Level Security (e.g. creating a new employee's
# login). Never share this one as casually as the publishable key above —
# treat it like a database password, not a public API key.
# From: Settings → API Keys → Secret keys section (sb_secret_...)
SUPABASE_SECRET_KEY=sb_secret_...
